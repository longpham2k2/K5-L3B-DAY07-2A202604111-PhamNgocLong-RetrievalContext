# Day 6 pgvector index (same database the Day 6 ingestion wrote to).
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DBNAME
# Must match the model that built the index; DenseRetriever checks this.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Agent model (src/providers.py). PROVIDER: gemini | openai | openrouter | anthropic | ollama
PROVIDER=gemini
MODEL=gemini-3.5-flash-lite
TEMPERATURE=0
GEMINI_API_KEY=
# OPENAI_API_KEY=
# Local model via Ollama (no key): PROVIDER=ollama, MODEL=<model with tool support>
# OLLAMA_BASE_URL=http://localhost:11434/v1
